{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MettaMazza/ernos-labs-sft-platform/edu/templates/book_manifest.schema.json",
  "title": "SFT educational book manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "book_id",
    "title",
    "version",
    "status",
    "stage",
    "branches",
    "knowledge_boundary",
    "scientific_sources",
    "provenance_policy",
    "author",
    "license",
    "artifacts",
    "release_checks"
  ],
  "properties": {
    "schema": {"const": "sft-education-book-manifest/1"},
    "book_id": {"type": "string", "pattern": "^SFT-EDU-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["planning", "draft", "review", "live", "superseded", "withdrawn"]},
    "stage": {"enum": ["early_years", "ages_5_7", "ages_7_11", "ages_11_14", "gcse_age", "post_16", "undergraduate", "advanced"]},
    "branches": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "knowledge_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit", "census_claim_count", "inspected_date"],
      "properties": {
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "census_claim_count": {"type": "integer", "minimum": 1},
        "inspected_date": {"type": "string", "format": "date"},
        "notes": {"type": "string"}
      }
    },
    "scientific_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "receipt_hash", "receipt_path", "use"],
        "properties": {
          "claim_id": {"type": "string"},
          "receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "receipt_path": {"type": "string"},
          "use": {"type": "string"}
        }
      }
    },
    "provenance_policy": {"type": "string", "minLength": 1},
    "external_references": {"type": "array", "items": {"type": "object"}},
    "author": {"const": "Maria Smith"},
    "editorial_assistance": {"type": "string"},
    "license": {"const": "CC-BY-4.0"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "release_checks": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    }
  }
}
