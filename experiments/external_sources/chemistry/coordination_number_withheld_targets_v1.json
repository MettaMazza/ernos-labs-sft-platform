    {
      "authority": "IUPAC",
      "snapshot_path": "experiments/external_sources/chemistry/snapshots/inorg-002-coordination-number-v1/iupac-coordination-number.json",
      "snapshot_sha256": "sha256:5c995bf40117e65eb042dc5d585692c56443ef3dc93805466779053da415fb5a",
      "source_document_identity": "iupac-coordination-number.json",
      "source_inscription": "The coordination number of a specified atom in a chemical species is the number of other atoms directly linked to that specified atom. For example, the coordination number of carbon in methane is four, and it is five in protonated methane, $\\ce{CH5^{+}$. (The term is used in a different sense in the crystallographic description of ionic crystals.)",
      "source_locator": "https://goldbook.iupac.org/terms/view/C01331/json",
      "source_record_ordinal": 2,
      "source_record_role": "general-direct-link-definition",
      "status": "reported-authoritative-record",
      "target_id": "SFT-CHEM-INORG002-COUNT-002",
      "target_payload_hash": "sha256:96e448e97df309e6484fad8ba2a952664af4f8c98f844f95657413f6964e34e2"
    },
    {
      "authority": "IUPAC",
      "snapshot_path": "experiments/external_sources/chemistry/snapshots/inorg-002-coordination-number-v1/iupac-coordination-number.json",
      "snapshot_sha256": "sha256:5c995bf40117e65eb042dc5d585692c56443ef3dc93805466779053da415fb5a",
      "source_document_identity": "iupac-coordination-number.json",
      "source_inscription": "In an inorganic coordination entity, the number of $\\ce{\\upsigma\\!\\mbox{-}bonds}$ between ligands and the central atom. $\\ce{\\uppi\\!\\mbox{-}bonds}$ are not considered in determining the coordination number.",
      "source_locator": "https://goldbook.iupac.org/terms/view/C01331/json",
      "source_record_ordinal": 3,
      "source_record_role": "inorganic-sigma-link-definition",
      "status": "reported-authoritative-record",
      "target_id": "SFT-CHEM-INORG002-COUNT-003",
      "target_payload_hash": "sha256:084ed54301da5690d47287844031867d37b062da578e5716a102105b64c66e6d"
